+    const frequency = frequencyScore(memory.injectCount);
+    const pinned = Number(memory.isPinned) ? 1 : 0;
+    return { recency, authority, frequency, pinned, total: 0.35 * recency + 0.25 * authority + 0.15 * frequency + 0.25 * pinned };
