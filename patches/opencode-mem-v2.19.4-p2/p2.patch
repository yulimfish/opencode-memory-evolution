+// ---------------------------------------------------------------------------
+// Importance
+// ---------------------------------------------------------------------------
+const AUTHORITY_SCORES = {
+    user: 1.0,
+    verified: 0.9,
+    trusted: 0.9,
+    observed: 0.65,
+    agent: 0.4,
+    inferred: 0.35,
