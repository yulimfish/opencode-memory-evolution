+    const m = String(message).trim();
+    const hasCJK = CJK_RE.test(m);
+    // Slash commands and bare shell lines only count when the turn is purely
+    // that command — a Chinese sentence that merely starts with "/tmp" or
+    // "git 提交一下…" is a normal request and must still get retrieval.
+    if (/^\/[a-z0-9_-]+/i.test(m) && !hasCJK)
+        return { inject: false, reason: "slash-command" };
+    if (SOCIAL_RE.test(m))
+        return { inject: false, reason: "social" };
+    if (!hasCJK && BARE_COMMAND_RE.test(m))
+        return { inject: false, reason: "bare-command" };
+    if (PUNCT_ONLY_RE.test(m))
+        return { inject: false, reason: "punct-only" };
+    return { inject: true, reason: "content" };
+}
