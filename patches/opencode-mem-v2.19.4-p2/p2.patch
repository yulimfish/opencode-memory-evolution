--- a/dist/services/hybrid-search.js	1970-01-01 08:00:00
+++ b/dist/services/hybrid-search.js	2026-09-12 22:13:46
@@ -0,0 +1,385 @@
+// P2: hybrid retrieval scoring for automatic injection.
+//
+// Replaces the recency-only injection ranking with:
+//   score = similarity (vector) + lexical overlap + importance + time fit
+// where importance = recency decay + pinned + authority + injection frequency,
+// and time fit is driven by time references parsed out of the user message
+// (e.g. "yesterday", "last week", "3 days ago", "2026-08-15").
+//
+// Everything here is pure (no DB / no network) so it can be unit-tested and
+// reused by the offline comparison harness.
+const DAY = 86400000;
+const CJK_RE = /[\u3400-\u4dbf\u4e00-\u9fff\uf900-\ufaff\u3040-\u30ff\uac00-\ud7af]/;
+// ---------------------------------------------------------------------------
+// Token estimation and text tokenization
+// ---------------------------------------------------------------------------
+export function estimateTokens(text) {
+    if (!text)
+        return 0;
+    let cjk = 0;
+    let otherChars = 0;
+    for (const ch of String(text)) {
+        if (CJK_RE.test(ch))
+            cjk++;
+        else
+            otherChars++;
+    }
+    return Math.max(1, cjk + Math.ceil(otherChars / 4));
+}
+export function truncateTextToTokens(text, budget) {
+    if (!text || budget <= 0)
+        return "";
+    if (estimateTokens(text) <= budget)
+        return text;
+    const lines = String(text).split("\n");
+    const kept = [];
+    let used = 0;
+    for (const line of lines) {
+        const cost = estimateTokens(line) + 1;
+        if (used + cost > budget)
+            break;
+        kept.push(line);
+        used += cost;
+    }
+    if (kept.length === 0)
+        return "";
+    return kept.join("\n") + "\n…";
+}
+export function tokenizeQuery(text) {
+    if (!text)
+        return [];
+    const lower = String(text).toLowerCase();
+    const tokens = new Set();
+    for (const word of lower.match(/[a-z0-9_][a-z0-9_.-]{1,}/g) || []) {
+        tokens.add(word);
+    }
+    for (const seq of lower.match(/[\u3400-\u4dbf\u4e00-\u9fff\uf900-\ufaff\u3040-\u30ff\uac00-\ud7af]+/g) || []) {
+        if (seq.length === 1) {
+            tokens.add(seq);
+            continue;
+        }
+        for (let i = 0; i < seq.length - 1; i++) {
+            tokens.add(seq.slice(i, i + 2));
+        }
+    }
+    return Array.from(tokens);
+}
+export function lexicalScore(queryTokens, memoryText, memoryTags) {
+    if (!queryTokens || queryTokens.length === 0)
+        return 0;
+    const text = String(memoryText || "").toLowerCase();
+    const tagText = Array.isArray(memoryTags) ? memoryTags.join(",").toLowerCase() : String(memoryTags || "").toLowerCase();
+    let matched = 0;
+    for (const token of queryTokens) {
+        if (text.includes(token) || tagText.includes(token))
+            matched++;
+    }
+    return matched / queryTokens.length;
+}
+function jaccard(a, b) {
+    const sa = new Set(a);
+    const sb = new Set(b);
+    if (sa.size === 0 || sb.size === 0)
+        return 0;
+    let intersection = 0;
+    for (const token of sa) {
+        if (sb.has(token))
+            intersection++;
+    }
+    return intersection / (sa.size + sb.size - intersection);
+}
+// ---------------------------------------------------------------------------
+// Time reference parsing ("time-aware query expansion")
+// ---------------------------------------------------------------------------
+function startOfDay(ts) {
+    const d = new Date(ts);
+    d.setHours(0, 0, 0, 0);
+    return d.getTime();
+}
+function startOfWeek(ts) {
+    const d = new Date(startOfDay(ts));
+    const day = (d.getDay() + 6) % 7; // Monday = 0
+    return d.getTime() - day * DAY;
+}
+function startOfMonth(ts) {
+    const d = new Date(ts);
+    return new Date(d.getFullYear(), d.getMonth(), 1).getTime();
+}
+function startOfYear(ts) {
+    const d = new Date(ts);
+    return new Date(d.getFullYear(), 0, 1).getTime();
+}
+function addMonths(ts, n) {
+    const d = new Date(ts);
+    return new Date(d.getFullYear(), d.getMonth() + n, d.getDate()).getTime();
+}
+export function parseTimeReference(text, now = Date.now()) {
+    if (!text)
+        return null;
+    const t = String(text).toLowerCase();
+    let start = null;
+    let end = null;
+    let directional = false;
+    let label = null;
+    const setWindow = (s, e, name) => {
+        start = start === null ? s : Math.min(start, s);
+        end = end === null ? e : Math.max(end, e);
+        label = label ? `${label}+${name}` : name;
+    };
+    // "N days/weeks/months/years ago" and Chinese equivalents.
+    const agoRe = /(\d+)\s*(天|日|周|星期|个?月|年)\s*(前|之前)/g;
+    for (const m of t.matchAll(agoRe)) {
+        const n = Number(m[1]);
+        const unit = m[2];
+        const anchor = now - n * (unit.includes("月") ? 30 * DAY : unit.includes("年") ? 365 * DAY : unit.includes("周") || unit.includes("星期") ? 7 * DAY : DAY);
+        setWindow(startOfDay(anchor), startOfDay(anchor) + DAY, `${n}${unit}前`);
+    }
+    const agoEnRe = /(\d+)\s*(day|week|month|year)s?\s+ago/g;
+    for (const m of t.matchAll(agoEnRe)) {
+        const n = Number(m[1]);
+        const unit = m[2];
+        const anchor = now - n * (unit === "month" ? 30 * DAY : unit === "year" ? 365 * DAY : unit === "week" ? 7 * DAY : DAY);
+        setWindow(startOfDay(anchor), startOfDay(anchor) + DAY, `${n} ${unit} ago`);
+    }
+    // Full Chinese date first: 2026年8月15日 — consumed so the month-day and
+    // year-month rules below do not widen it to the whole month.
+    let scan = t;
+    for (const m of t.matchAll(/(\d{4})年(\d{1,2})月(\d{1,2})[日号]/g)) {
+        const d = new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]));
+        setWindow(d.getTime(), d.getTime() + DAY, m[0]);
+        scan = scan.replace(m[0], " ");
+    }
+    // ISO-ish dates: 2026-08-15 / 2026/8/15 / 2026.8.15
+    for (const m of t.matchAll(/(\d{4})[-/.](\d{1,2})[-/.](\d{1,2})/g)) {
+        const d = new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]));
+        setWindow(d.getTime(), d.getTime() + DAY, m[0]);
+    }
+    // Chinese month-day: 8月15日 (current year assumed)
+    for (const m of scan.matchAll(/(\d{1,2})月(\d{1,2})[日号]/g)) {
+        const d = new Date(new Date(now).getFullYear(), Number(m[1]) - 1, Number(m[2]));
+        setWindow(d.getTime(), d.getTime() + DAY, m[0]);
+    }
+    // Chinese year-month: 2026年8月
+    for (const m of scan.matchAll(/(\d{4})年(\d{1,2})月/g)) {
+        const d = new Date(Number(m[1]), Number(m[2]) - 1, 1);
+        setWindow(d.getTime(), addMonths(d.getTime(), 1), m[0]);
+    }
+    const fixed = [
+        [/今天|今日|\btoday\b/, () => setWindow(startOfDay(now), now, "today")],
+        [/昨天|昨日|\byesterday\b/, () => setWindow(startOfDay(now - DAY), startOfDay(now), "yesterday")],
+        [/前天/, () => setWindow(startOfDay(now - 2 * DAY), startOfDay(now - DAY), "before yesterday")],
+        [/上周|上星期|\blast week\b/, () => setWindow(startOfWeek(now) - 7 * DAY, startOfWeek(now), "last week")],
+        [/这周|本周|这星期|\bthis week\b/, () => setWindow(startOfWeek(now), now, "this week")],
+        [/上个月|上月|\blast month\b/, () => setWindow(startOfMonth(addMonths(startOfMonth(now), -1)), startOfMonth(now), "last month")],
+        [/这个月|本月|\bthis month\b/, () => setWindow(startOfMonth(now), now, "this month")],
+        [/去年|\blast year\b/, () => setWindow(startOfYear(new Date(now).setFullYear(new Date(now).getFullYear() - 1)), startOfYear(now), "last year")],
+        [/今年|\bthis year\b/, () => setWindow(startOfYear(now), now, "this year")],
+        [/刚才|刚刚|\bjust now\b/, () => setWindow(now - 2 * 3600000, now, "just now")],
+    ];
+    for (const [re, fn] of fixed) {
+        if (re.test(t))
+            fn();
+    }
+    // Directional recent refs: no absolute window, only "prefer fresh".
+    if (/最近|近期|近日|这几天|\brecently\b|\blately\b|\bthese days\b/.test(t)) {
+        directional = true;
+        setWindow(now - 7 * DAY, now, "recent");
+    }
+    if (/上次|上一次|\blast time\b|\bthe other day\b/.test(t)) {
+        directional = true;
+        setWindow(now - 14 * DAY, now, "last time");
+    }
+    if (start === null)
+        return null;
+    return { start, end: end === null ? now : end, directional, label: label || "time" };
+}
+export function timeFitScore(createdAt, timeRef, now = Date.now()) {
+    if (!timeRef)
+        return 0;
+    const created = Number(createdAt) || 0;
+    if (created <= 0)
+        return 0;
+    if (created >= timeRef.start && created <= timeRef.end)
+        return 1;
+    const excessDays = created < timeRef.start
+        ? (timeRef.start - created) / DAY
+        : (created - timeRef.end) / DAY;
+    const halfLife = timeRef.directional ? 14 : 3;
+    return Math.pow(0.5, excessDays / halfLife);
