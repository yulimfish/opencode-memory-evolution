+    return AUTHORITY_SCORES[String(authority).trim().toLowerCase()] ?? 0.5;
+}
+export function recencyScore(createdAt, now = Date.now(), halfLifeDays = 45) {
+    const created = Number(createdAt) || 0;
+    if (created <= 0)
+        return 0;
+    const ageDays = Math.max(0, (now - created) / DAY);
+    return Math.pow(0.5, ageDays / halfLifeDays);
+}
+export function frequencyScore(injectCount) {
+    const n = Math.max(0, Number(injectCount) || 0);
